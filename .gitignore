# Omarchy-managed — not user configs
machines/*/.config/omarchy/backgrounds/
machines/*/.config/omarchy/themes/
machines/*/.config/omarchy/current/theme/backgrounds/

# Build artifacts — reinstall with: pip install --target ... bscpylgtv (venv)
machines/*/.local/lgpowercontrol/bscpylgtv/

# Junk
*.bak
*.bak.*
__pycache__/
*.pyc
.DS_Store

# Plaintext WiFi credentials — never commit
**/iwd-credentials-backup/
*.psk
*.nmconnection

# Sunshine runtime state -- written into the repo because ~/.config/sunshine is
# a stow-folded link. Private key, pairing state and logs must never be pushed.
machines/*/.config/sunshine/credentials/
machines/*/.config/sunshine/sunshine_state.json
machines/*/.config/sunshine/*.log
