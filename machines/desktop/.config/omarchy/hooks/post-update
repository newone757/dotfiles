#!/bin/bash

# Re-apply LG TV power control customizations to hypridle.conf if omarchy update overwrote them.
HYPRIDLE=~/.config/hypr/hypridle.conf
BSCPYLGTV=/home/lonnie/.local/lgpowercontrol/bscpylgtv/bin/bscpylgtvcommand
WAKE_HDMI=~/.local/lgpowercontrol/wake-hdmi.sh

if ! grep -q "wake-hdmi.sh" "$HYPRIDLE"; then
    # Patch after_sleep_cmd
    sed -i 's|\(after_sleep_cmd = sleep 3\).*|\1; hyprctl keyword monitor HDMI-A-2,disable; wakeonlan 00:a1:59:35:35:da; omarchy-system-wake; sleep 10; hyprctl keyword monitor "HDMI-A-2,3840x2160@120,0x0,1"|' "$HYPRIDLE"

    # Patch lock on-timeout to power off TV
    sed -i 's|\(on-timeout = omarchy-system-lock\)$|\1 \&\& timeout 10 '"$BSCPYLGTV"' 10.0.1.28 power_off|' "$HYPRIDLE"

    # Patch on-resume to wake TV via WOL + smart HDMI handshake
    sed -i 's|\(on-resume = omarchy-system-wake\).*|\1; sleep 2; wakeonlan 00:a1:59:35:35:da; sleep 3; wakeonlan 00:a1:59:35:35:da; sleep 3; '"$WAKE_HDMI"'|' "$HYPRIDLE"

    notify-send "Omarchy Update" "Re-applied LG TV power control to hypridle.conf"
fi
