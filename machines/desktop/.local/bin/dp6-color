#!/usr/bin/env python3
"""dp6-color - slider UI for the DP-6 panel's DDC/CI color controls.

Why this exists instead of ddcui: on this panel the RGB gain registers
(0x16/0x18/0x1A) are WRITE-ONLY. Writes apply, but reads always return the
factory constants 49/46/50. ddcui positions its sliders from read-back, so
they snap to phantom values and switching channels writes from that stale
state, throwing the color cast wildly.

Worse, the three gains are not independent: the panel has ONE gain register
plus a channel selector. Writing any channel drops the previously-written one
back to default, so only the most recent channel holds a non-default value.
Verified by experiment - both bundled writes and writes spaced 2s apart lose
the earlier channels. This app therefore exposes exactly one gain channel at
a time, and never reads the gains back.

Brightness (0x10) and contrast (0x12) DO read back honestly, so they are
seeded from the monitor at startup.

0x0B/0x0C (color temperature request) are never touched: writing them out of
range latches the panel into rejecting all further writes.
"""
import json, os, re, subprocess, sys, threading, queue, html
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

CFG   = os.path.expanduser("~/.config/dp6-color")
STATE = os.path.join(CFG, "state.json")
PORT  = int(os.environ.get("DP6_PORT", "8765"))
CONNECTOR = os.environ.get("DP6_CONNECTOR", "DP-6")

GAINS = [("r", "16", "Red"), ("g", "18", "Green"), ("b", "1A", "Blue")]
FACTORY = {"channel": "g", "gain": 46, "brightness": 31, "contrast": 48}
GAIN_DEFAULT = {"r": 49, "g": 46, "b": 50}

def bus_ok(bus):
    """Cheap (~0.4s) check that a cached bus still answers, vs a 7s full detect."""
    try:
        p = subprocess.run(["ddcutil", "--bus", bus, "--sleep-multiplier", ".3",
                            "getvcp", "10"], capture_output=True, text=True, timeout=15)
        return p.returncode == 0 and "current value" in p.stdout
    except Exception:
        return False

def get_bus(force=False):
    """Cached bus number. Full detection costs ~7s, so do it only when needed."""
    st = load_state()
    cached = st.get("bus")
    if cached and not force and bus_ok(cached):
        return cached
    bus = detect_bus()
    st["bus"] = bus
    save_state(st)
    return bus

def detect_bus():
    """Find the I2C bus for CONNECTOR once, so writes can use --bus (7s -> 0.6s)."""
    try:
        out = subprocess.run(["ddcutil", "detect", "--brief"], capture_output=True,
                             text=True, timeout=90).stdout
    except Exception as e:
        sys.exit(f"ddcutil detect failed: {e}")
    bus = None
    for block in out.split("\n\n"):
        if CONNECTOR in block:
            m = re.search(r"/dev/i2c-(\d+)", block)
            if m:
                bus = m.group(1)
    if not bus:
        sys.exit(f"Could not find {CONNECTOR} in ddcutil detect output.")
    return bus

BUS = None

def ddc(*args, timeout=30):
    cmd = ["ddcutil", "--bus", BUS, "--sleep-multiplier", ".3", *args]
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout + p.stderr
    except subprocess.TimeoutExpired:
        return 1, "timeout"

def read_honest():
    """Seed brightness/contrast from the monitor - these two read back correctly."""
    rc, out = ddc("getvcp", "10", "12", timeout=60)
    vals = {}
    for code, key in (("0x10", "brightness"), ("0x12", "contrast")):
        m = re.search(re.escape(code) + r"\b.*?current value =\s*(\d+)", out)
        if m:
            vals[key] = int(m.group(1))
    return vals

def load_state():
    st = dict(FACTORY); st["profiles"] = {}
    if os.path.exists(STATE):
        try:
            st.update(json.load(open(STATE)))
        except Exception:
            pass
    st.setdefault("profiles", {})
    return st

def save_state(st):
    tmp = STATE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(st, f, indent=2)
    os.replace(tmp, STATE)

state = None
apply_q = queue.Queue()

def apply_worker():
    """Coalescing worker: only the most recent target is ever written.

    Two panel quirks drive the ordering:
      * writing 0x10/0x12 re-applies the preset colour and wipes the gain,
        so brightness/contrast go FIRST and only when actually changed;
      * only ONE gain channel can hold a non-default value, so exactly one
        gain write is issued, LAST.
    """
    last = {}
    while True:
        target = apply_q.get()
        while True:                      # drain to the newest request
            try: target = apply_q.get_nowait()
            except queue.Empty: break
        if target is None:
            return

        bc = ["setvcp"]
        for key, code in (("brightness", "10"), ("contrast", "12")):
            if last.get(key) != target[key]:
                bc += [code, str(target[key])]
        if len(bc) > 1:
            ddc(*bc, timeout=60)

        code = dict((k, c) for k, c, _ in GAINS)[target["channel"]]
        ddc("setvcp", code, str(target["gain"]), timeout=60)

        last = dict(target)

def do_reset():
    """Clear the latched reject state: factory colour defaults, then User 1."""
    ddc("setvcp", "08", "1", timeout=60)
    ddc("setvcp", "14", "0x0b", timeout=60)   # User 1 unlocks the gains

PAGE = r"""<title>DP-6 Color</title>
<style>
:root{--bg:#f6f6f4;--fg:#1a1a19;--mut:#6b6b66;--card:#fff;--line:#e0e0dc;--accent:#7c5cff;--warn:#8a6d1f;--warnbg:#fdf6e3}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#16161a;--fg:#ececea;--mut:#9a9a94;--card:#1f1f25;--line:#31313a;--warn:#e0c060;--warnbg:#2a2418}}
:root[data-theme="dark"]{--bg:#16161a;--fg:#ececea;--mut:#9a9a94;--card:#1f1f25;--line:#31313a;--warn:#e0c060;--warnbg:#2a2418}
