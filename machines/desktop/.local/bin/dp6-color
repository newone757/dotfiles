<script>
const GDEF={r:49,g:46,b:50}, CODE={r:'16',g:'18',b:'1A'}, NAME={r:'Red',g:'Green',b:'Blue'};
let S={channel:'g',gain:46,brightness:31,contrast:3}, P={}, BUS='', timer=null;

function bindNum(k){
  const s=document.getElementById('s_'+k), n=document.getElementById('n_'+k);
  s.addEventListener('input',()=>{S[k]=+s.value;n.value=s.value;paint();push()});
  n.addEventListener('change',()=>{const v=Math.max(0,Math.min(100,+n.value||0));
    S[k]=v;s.value=v;n.value=v;paint();push()});
}
function setCh(c){ S.channel=c; S.gain=GDEF[c]; paint(); push(); }
function paint(){
  ['gain','brightness','contrast'].forEach(k=>{
    document.getElementById('s_'+k).value=S[k];
    document.getElementById('n_'+k).value=S[k];});
  document.querySelectorAll('#seg button').forEach(b=>
    b.classList.toggle('on', b.dataset.c===S.channel));
  document.getElementById('glab').textContent=NAME[S.channel]+' gain';
  document.getElementById('defnote').textContent=
    'Default for '+NAME[S.channel]+' is '+GDEF[S.channel]+'. Lower = less '+
    NAME[S.channel].toLowerCase()+'.';
  document.getElementById('cmd').textContent=
    `ddcutil --bus ${BUS} setvcp 10 ${S.brightness} 12 ${S.contrast} ; `+
    `ddcutil --bus ${BUS} setvcp ${CODE[S.channel]} ${S.gain}`;
}
function push(){clearTimeout(timer);timer=setTimeout(send,150)}
function send(){say('applying…');
  fetch('/api/apply',{method:'POST',body:JSON.stringify(S)})
    .then(r=>r.json()).then(()=>say('applied')).catch(()=>say('failed'))}
function say(m){document.getElementById('st').textContent=m}
function reapply(){send()}
function factory(){S={channel:S.channel,gain:GDEF[S.channel],brightness:31,contrast:48};paint();send()}
function reset(){say('resetting…');fetch('/api/reset',{method:'POST'})
  .then(r=>r.json()).then(()=>{say('panel reset — re-applying');send()})}
function saveP(){const n=document.getElementById('pname').value.trim();if(!n)return;
  fetch('/api/profile',{method:'POST',body:JSON.stringify({name:n,vals:S})})
    .then(r=>r.json()).then(d=>{fillP(d.profiles);say('saved '+n)})}
function delP(){const n=document.getElementById('psel').value;if(!n)return;
  fetch('/api/profile',{method:'POST',body:JSON.stringify({name:n,del:1})})
    .then(r=>r.json()).then(d=>{fillP(d.profiles);say('deleted '+n)})}
function loadP(){const n=document.getElementById('psel').value;if(!n||!P[n])return;
  S={...S,...P[n]};paint();send()}
function fillP(p){P=p;document.getElementById('psel').innerHTML=
  '<option value="">load profile…</option>'+Object.keys(p).map(k=>`<option>${k}</option>`).join('')}
['gain','brightness','contrast'].forEach(bindNum);
fetch('/api/state').then(r=>r.json()).then(d=>{
  BUS=d.bus; ['channel','gain','brightness','contrast'].forEach(k=>{
    if(d.state[k]!=null)S[k]=d.state[k]});
  fillP(d.state.profiles||{});paint();say('ready');
});
</script>"""

class H(BaseHTTPRequestHandler):
    def log_message(self, *a): pass

    def _send(self, code, body, ctype):
        b = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(b)))
        self.end_headers()
        self.wfile.write(b)

    def do_GET(self):
        if self.path == "/":
            self._send(200, "<!doctype html>" + PAGE, "text/html; charset=utf-8")
        elif self.path == "/api/state":
            self._send(200, json.dumps({"state": state, "bus": BUS}), "application/json")
        else:
            self._send(404, "no", "text/plain")

    def do_POST(self):
        n = int(self.headers.get("Content-Length") or 0)
        try:
            data = json.loads(self.rfile.read(n) or "{}")
        except Exception:
            data = {}
        if self.path == "/api/apply":
            if data.get("channel") in ("r", "g", "b"):
                state["channel"] = data["channel"]
            for k in ("gain", "brightness", "contrast"):
                if k in data:
                    state[k] = max(0, min(100, int(data[k])))
            save_state(state)
            apply_q.put({k: state[k] for k in ("channel","gain","brightness","contrast")})
            self._send(200, json.dumps({"ok": 1}), "application/json")
        elif self.path == "/api/reset":
            do_reset()
            self._send(200, json.dumps({"ok": 1}), "application/json")
        elif self.path == "/api/profile":
            name = (data.get("name") or "").strip()
            if name:
                if data.get("del"):
                    state["profiles"].pop(name, None)
                else:
                    state["profiles"][name] = data.get("vals") or {}
                save_state(state)
            self._send(200, json.dumps({"profiles": state["profiles"]}), "application/json")
        else:
            self._send(404, "no", "text/plain")

def apply_now(vals):
    """One-shot apply, same ordering rules as the worker."""
    bc = ["setvcp"]
    for key, code in (("brightness", "10"), ("contrast", "12")):
        if vals.get(key) is not None:
            bc += [code, str(vals[key])]
    if len(bc) > 1:
        ddc(*bc, timeout=60)
    ch = vals.get("channel")
    if ch in ("r", "g", "b"):
        code = dict((k, c) for k, c, _ in GAINS)[ch]
        ddc("setvcp", code, str(vals["gain"]), timeout=60)

def port_busy():
    import socket
    with socket.socket() as sk:
        sk.settimeout(0.4)
        return sk.connect_ex(("127.0.0.1", PORT)) == 0

WM_CLASS = "dp6-color"

def launch_webapp():
    """Start the server if needed, then open it as a standalone app window
    (not a browser tab) with a fixed WM class so Hyprland can float it."""
    import time
    if not port_busy():
        subprocess.Popen(["setsid", sys.executable, os.path.abspath(__file__), "--no-open"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         stdin=subprocess.DEVNULL, start_new_session=True)
        for _ in range(60):                 # wait for it to bind (~up to 30s)
            if port_busy():
                break
            time.sleep(0.5)
        else:
            sys.exit("server did not start")
    url = f"http://127.0.0.1:{PORT}/"
    subprocess.Popen(["omarchy-launch-webapp", url, f"--class={WM_CLASS}"],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print(f"opened {url} as webapp (class {WM_CLASS})")

def main():
    global BUS, state
    args = sys.argv[1:]

    if "--webapp" in args:
        launch_webapp()
        return

    # --- one-shot modes: no server, for menu entries ---
    if "--apply" in args:
        BUS = get_bus("--redetect" in sys.argv)
        st = load_state()
        name = args[args.index("--apply") + 1] if len(args) > args.index("--apply") + 1 else ""
        vals = st["profiles"].get(name)
        if vals is None:
            sys.exit(f"no such profile: {name}  (have: {', '.join(st['profiles']) or 'none'})")
        apply_now(vals)
        st.update({k: v for k, v in vals.items() if k != "profiles"})
        save_state(st)
        print(f"applied profile {name}")
        return
    if "--reset" in args:
        BUS = get_bus("--redetect" in sys.argv)
        do_reset()
        st = load_state()
        apply_now(st)
        print("panel reset, settings re-applied")
        return
    if "--list" in args:
        print("\n".join(load_state()["profiles"]) or "(no profiles)")
        return

    # --- server mode: if one is already up, just focus the browser ---
    if port_busy():
        url = f"http://127.0.0.1:{PORT}/"
        print(f"already running: {url}")
        if "--no-open" not in args:
            subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL)
        return

    BUS = get_bus("--redetect" in sys.argv)
    state = load_state()
    if not os.path.exists(STATE):
        state.update(read_honest())     # seed brightness/contrast from the panel
        save_state(state)
    threading.Thread(target=apply_worker, daemon=True).start()
    srv = ThreadingHTTPServer(("127.0.0.1", PORT), H)
    url = f"http://127.0.0.1:{PORT}/"
    print(f"DP-6 color UI on {url}  (bus {BUS})")
    if "--no-open" not in args:
        subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print("\nbye")

if __name__ == "__main__":
    main()
