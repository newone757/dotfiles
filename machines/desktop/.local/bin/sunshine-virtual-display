#!/usr/bin/env bash
# Create/destroy a headless Hyprland output for Sunshine to capture, sized to
# the connecting client. Without this, Sunshine captures the physical 4K
# HDMI-A-2 and the remote session is a downscale of it -- tiny UI, and
# letterboxed whenever the client isn't 16:9.
#
# Driven by Sunshine's global_prep_cmd, which exports SUNSHINE_CLIENT_*.
# Hyprland's headless outputs only ever advertise 1920x1080, and monitor rules
# are ignored for them, so the real mode is set over wlr-output-management
# (wlr-randr), which does accept custom modes.
set -uo pipefail

NAME=sunshine
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

if [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
  export HYPRLAND_INSTANCE_SIGNATURE="$(ls -t "$XDG_RUNTIME_DIR/hypr" 2>/dev/null | head -1)"
fi
# wlr-randr needs WAYLAND_DISPLAY; Sunshine's unit normally has it, but a bare
# shell (ssh, tty) does not -- fall back to the first real wayland socket.
if [[ -z "${WAYLAND_DISPLAY:-}" ]]; then
  for s in "$XDG_RUNTIME_DIR"/wayland-*; do
    [[ -S "$s" ]] && { export WAYLAND_DISPLAY="${s##*/}"; break; }
  done
fi

# Client geometry, with sane fallbacks for a manual run.
W="${SUNSHINE_CLIENT_WIDTH:-1920}"
H="${SUNSHINE_CLIENT_HEIGHT:-1080}"
F="${SUNSHINE_CLIENT_FPS:-60}"
[[ "$W" =~ ^[0-9]+$ && "$W" -ge 640  && "$W" -le 7680 ]] || W=1920
[[ "$H" =~ ^[0-9]+$ && "$H" -ge 480  && "$H" -le 4320 ]] || H=1080
[[ "$F" =~ ^[0-9]+$ && "$F" -ge 24   && "$F" -le 240  ]] || F=60

exists() {
  hyprctl monitors -j 2>/dev/null | jq -e --arg n "$NAME" '.[]|select(.name==$n)' >/dev/null 2>&1
}

geometry() {
  hyprctl monitors -j 2>/dev/null | jq -r --arg n "$NAME" '.[]|select(.name==$n)|"\(.width)x\(.height)"'
}

remove() {
  if exists; then hyprctl output remove "$NAME" >/dev/null 2>&1; fi
  return 0
}

case "${1:-}" in
  start)
    remove                                   # clear any stale output first
    hyprctl output create headless "$NAME" >/dev/null 2>&1
    for _ in $(seq 20); do
      if exists; then break; fi
      sleep 0.25
    done
    if ! exists; then
      echo "sunshine-virtual-display: failed to create output '$NAME'" >&2
      exit 1
    fi

    # Headless comes up 1920x1080; resize to the client's geometry, and park it
    # away from the physical layout (HDMI-A-2 0,0 + DP-6 below) with a gap so
    # the cursor can never wander between desktop and stream. Mode and position
    # go in ONE call: a separate --pos re-applies the headless default mode.
    wlr-randr --output "$NAME" --custom-mode "${W}x${H}@${F}" --pos 20000,0 >/dev/null 2>&1
    if [[ "$W" != 1920 || "$H" != 1080 ]]; then
      for _ in $(seq 12); do
        [[ "$(geometry)" == "${W}x${H}" ]] && break
        sleep 0.25
      done
      if [[ "$(geometry)" != "${W}x${H}" ]]; then
        # Non-fatal: streaming at 1920x1080 beats not streaming at all.
        echo "sunshine-virtual-display: wanted ${W}x${H}, got $(geometry)" >&2
      fi
    fi
    echo "sunshine-virtual-display: $NAME at $(geometry)@${F}"
    ;;
  stop)
    remove
    ;;
  *)
    echo "usage: ${0##*/} start|stop" >&2
    exit 2
    ;;
esac
